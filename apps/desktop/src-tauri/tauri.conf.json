{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreamPub",
  "version": "0.2.1",
  "identifier": "com.dreampub.game",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DreamPub",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/dreampub-server"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
